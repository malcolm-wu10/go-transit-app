# Get this by registering at https://api.gotransit.com (GO API Registration)
GO_API_KEY=your_key_here

# Metrolinx GTFS-RT / GTFS static endpoints (confirm exact paths in your GO API account docs
# after registering — they are versioned and sometimes change).
GTFS_RT_VEHICLE_POSITIONS_URL=https://api.gotransit.com/v1/gtfs-rt/VehiclePositions
GTFS_RT_TRIP_UPDATES_URL=https://api.gotransit.com/v1/gtfs-rt/TripUpdates
GTFS_RT_ALERTS_URL=https://api.gotransit.com/v1/gtfs-rt/ServiceAlerts

# How often to poll Metrolinx for new vehicle positions (ms). Their feed refreshes ~once/minute,
# don't poll much faster than that or you'll just be hammering them for stale data.
POLL_INTERVAL_MS=30000

PORT=4000

# Set once you're running OpenTripPlanner locally (see README)
OTP_URL=http://localhost:8080/otp/routers/default
